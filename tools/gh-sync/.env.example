# Auth uses the `gh` CLI — run `gh auth login` first (scopes: repo, project). No tokens here.

# Optional: override the repo (defaults to `gh repo view` in the current directory)
# GH_REPO=owner/name

# Optional: enable Project board Status sync (run with `pnpm sync:project`)
# Get the number from the project URL: .../projects/<NUMBER>
# GH_PROJECT_NUMBER=1
# GH_PROJECT_OWNER=

# Optional: override the source-of-truth file (defaults to repo-root tasks/board.yaml)
# BOARD_FILE=../../tasks/board.yaml
