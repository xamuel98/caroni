{
  "name": "@caroni/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node dist/db/migrate.js",
    "gen:catalogue": "pnpm build && node scripts/generate-catalogue.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@caroni/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.18",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
