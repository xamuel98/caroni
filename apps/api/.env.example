# Copy to .env and fill in for local development.
# (`@nestjs/config` loads .env from apps/api automatically.)

NODE_ENV=development
PORT=3100

# Data + policy
DATABASE_URL=postgres://caroni:caroni@localhost:5432/caroni
OPA_URL=http://localhost:8181

# Browser origins: the ops/consumer dev servers.
CORS_ORIGINS=http://localhost:5173
POST_LOGIN_REDIRECT_URI=http://localhost:5173

# ThunderID (OIDC). THUNDER_CLIENT_ID is the OAuth client registered in ThunderID
# (Console → Applications), not the human-readable name.
THUNDER_ISSUER=https://localhost:8090
THUNDER_CLIENT_ID=
THUNDER_REDIRECT_URI=http://localhost:3100/auth/callback
THUNDER_SCOPE=openid profile email roles

# DEV ONLY: ThunderID serves a self-signed cert. Never set this in production.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Generate with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=

# DEV ONLY: comma-separated roles granted when the id_token carries none, so a
# local IdP without role plumbing still works. Rejected when NODE_ENV=production.
AUTH_DEV_ROLE_OVERRIDE=
